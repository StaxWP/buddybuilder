{
	"version": 1,
	"name": "activity-loop",
	"title": "Activity list",
	"category": "buddybuilder",
	"icon": "rss",
	"description": "Recent activity anywhere on the site.",
	"keywords": [
		"activity",
		"feed",
		"buddypress",
		"buddybuilder"
	],
	"templateTypes": [],
	"attributes": {
		"card": {
			"type": "string",
			"default": "classic",
			"control": "select",
			"panel": "basic",
			"label": "Card style",
			"help": "How each item looks. A card layout (BuddyBuilder Pro) replaces it.",
			"options": {
				"classic": "Classic",
				"compact": "Compact",
				"boxed": "Boxed"
			}
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true
		}
	},
	"legacy": {
		"elementor": [
			"bpb-general-activity-list"
		]
	}
}
