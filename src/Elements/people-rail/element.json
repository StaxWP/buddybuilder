{
	"version": 1,
	"name": "people-rail",
	"title": "People and groups list",
	"category": "buddybuilder",
	"icon": "groups",
	"description": "A short list for side columns: newest, active or popular members, the displayed member's friends or groups, or active groups. As a list or a photo grid.",
	"keywords": [
		"members",
		"groups",
		"sidebar",
		"rail",
		"who to follow",
		"buddypress",
		"buddybuilder"
	],
	"templateTypes": [],
	"attributes": {
		"title": {
			"type": "string",
			"default": "",
			"control": "text",
			"panel": "basic",
			"label": "Title"
		},
		"show_title": {
			"type": "boolean",
			"default": true,
			"control": "toggle",
			"panel": "advanced",
			"label": "Show the title"
		},
		"object": {
			"type": "string",
			"default": "members",
			"control": "select",
			"panel": "basic",
			"label": "Show",
			"options": {
				"members": "Members",
				"friends": "Friends of the displayed member",
				"groups": "Groups",
				"member-groups": "Groups of the displayed member"
			}
		},
		"order": {
			"type": "string",
			"default": "active",
			"control": "select",
			"panel": "advanced",
			"label": "Order",
			"options": {
				"active": "Recently active",
				"newest": "Newest",
				"popular": "Most friends or members"
			}
		},
		"count": {
			"type": "integer",
			"default": 5,
			"control": "number",
			"panel": "basic",
			"label": "How many",
			"min": 1,
			"max": 12
		},
		"layout": {
			"type": "string",
			"default": "list",
			"control": "select",
			"panel": "basic",
			"label": "Layout",
			"options": {
				"list": "List",
				"grid": "Photo grid"
			}
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true
		}
	}
}
