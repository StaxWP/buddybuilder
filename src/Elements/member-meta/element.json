{
	"version": 1,
	"name": "member-meta",
	"title": "Member last active",
	"category": "buddybuilder-header-parts",
	"icon": "clock",
	"description": "When the displayed member was last active.",
	"keywords": [
		"meta",
		"last active",
		"buddypress",
		"buddybuilder"
	],
	"templateTypes": [
		"member-profile"
	],
	"attributes": {
		"design": {
			"type": "string",
			"default": "",
			"control": "none"
		},
		"location_field": {
			"type": "string",
			"default": "Location",
			"control": "none"
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true
		}
	},
	"legacy": {
		"elementor": [
			"bpb-profile-member-meta"
		]
	},
	"partOf": {
		"use": "member-header"
	},
	"splitIgnores": [
		"color.background",
		"color.text",
		"color.link",
		"typography.fontSize",
		"border",
		"spacing.padding",
		"spacing.margin"
	]
}
