{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "buddybuilder/member-username",
	"title": "Member name",
	"category": "buddybuilder",
	"icon": "id",
	"description": "BuddyBuilder element. Renders for the displayed member (front end) or the preview member (editor).",
	"textdomain": "stax-buddy-builder",
	"attributes": { "username_type": { "type": "string", "enum": [ "username", "full_name" ], "default": "username" }, "username_tag": { "type": "string", "enum": [ "h1", "h2", "h3", "h4", "h5", "h6", "div", "span", "p" ], "default": "h2" } },
	"supports": { "html": false, "align": [ "wide", "full" ], "color": { "background": true, "text": true, "link": true }, "spacing": { "margin": true, "padding": true }, "typography": { "fontSize": true }, "__experimentalBorder": { "radius": true, "width": true, "color": true } },
	"editorScript": "bpb-blocks-editor",
	"bpbControls": { "username_type": { "label": "Show", "type": "select", "options": { "username": "@username", "full_name": "Name" } }, "username_tag": { "label": "HTML tag", "type": "select", "options": { "h1": "H1", "h2": "H2", "h3": "H3", "h4": "H4", "h5": "H5", "h6": "H6", "div": "div", "span": "span", "p": "p" } } }
}
