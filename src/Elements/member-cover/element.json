{
	"version": 1,
	"name": "member-cover",
	"title": "Member cover",
	"category": "buddybuilder-header-parts",
	"icon": "format-image",
	"description": "Cover image of the displayed member.",
	"keywords": [
		"header",
		"banner",
		"buddypress",
		"buddybuilder"
	],
	"templateTypes": [
		"member-profile"
	],
	"attributes": {
		"cover_advanced_settings": {
			"hideWhen": {
				"design": "header"
			},
			"type": "boolean",
			"default": false,
			"control": "toggle",
			"panel": "basic",
			"label": "Use the uploaded cover image as a background layer"
		},
		"overlay_background": {
			"hideWhen": {
				"design": "header"
			},
			"type": "boolean",
			"default": false,
			"control": "toggle",
			"panel": "advanced",
			"label": "Dark overlay"
		},
		"design": {
			"type": "string",
			"default": "",
			"control": "none"
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true
		},
		"dimensions": {
			"minHeight": true
		}
	},
	"legacy": {
		"elementor": [
			"bpb-profile-member-cover"
		]
	},
	"partOf": {
		"use": "member-header"
	},
	"splitIgnores": [
		"color.background",
		"color.text",
		"color.link",
		"typography.fontSize",
		"border",
		"spacing.padding",
		"spacing.margin",
		"dimensions.minHeight"
	]
}
