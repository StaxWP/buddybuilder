{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "buddybuilder/member-cover",
	"title": "Member cover",
	"category": "buddybuilder",
	"icon": "format-image",
	"description": "BuddyBuilder element. Renders for the displayed member (front end) or the preview member (editor).",
	"textdomain": "stax-buddy-builder",
	"attributes": { "cover_advanced_settings": { "type": "string", "enum": [ "", "yes" ], "default": "" }, "overlay_background": { "type": "string", "enum": [ "", "yes" ], "default": "" } },
	"supports": { "html": false, "dimensions": { "minHeight": true }, "align": [ "wide", "full" ], "color": { "background": true, "text": true, "link": true }, "spacing": { "margin": true, "padding": true }, "typography": { "fontSize": true }, "__experimentalBorder": { "radius": true, "width": true, "color": true } },
	"editorScript": "bpb-blocks-editor",
	"bpbControls": { "cover_advanced_settings": { "label": "Use the member cover image", "type": "toggle" }, "overlay_background": { "label": "Dark overlay", "type": "toggle" } }
}
