{
	"version": 1,
	"name": "member-list",
	"title": "Member list",
	"category": "buddybuilder",
	"icon": "admin-users",
	"description": "Members with their online status, grouped Online and Offline: the members of the current group, or the most recently active members.",
	"keywords": [
		"members",
		"online",
		"presence",
		"list",
		"buddypress",
		"buddybuilder"
	],
	"templateTypes": [],
	"attributes": {
		"count": {
			"type": "integer",
			"default": 16,
			"control": "number",
			"panel": "basic",
			"label": "How many",
			"min": 1,
			"max": 60
		},
		"drawer": {
			"type": "boolean",
			"default": true,
			"control": "toggle",
			"panel": "basic",
			"label": "Drawer on phones"
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true
		}
	}
}
